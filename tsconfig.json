{
    "compilerOptions": {
        "target": "es2016",
        "experimentalDecorators": true,
        "esModuleInterop": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "declaration": false,
        "noEmit": true,
        "jsx": "react",
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "./node_modules/matrix-js-sdk/src/@types/*.d.ts",
        "./src/**/*.ts", 
        "./src/**/*.tsx", 
        "./test/**/*.ts"
    ]
}
